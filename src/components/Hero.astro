---
import { reserves } from '../content/home';
import { site } from '../config/site';
import Contract from './Contract.astro';
import HeroArt from './HeroArt.astro';
const live = site.token.status === 'live';
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <div class="eyebrow">Frozen USD · $FUSD</div>
    <span class="identity">MEMECOIN PARODY</span>
    <h1 id="hero-title">
      The dollar that
      <br class="desktop-break" /> trades frozen.
    </h1>
    <p class="hero-description">
      Transfer it. Trade it.
      <br />
      No thawing required.
    </p>
    <p class="signature">Frozen. Still moving.</p>
    <p class="hero-reserve-claim">
      <a href="#reserves">
        {reserves.heroClaim}
        <svg
          class="arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M6 18 18 6M6 6h12v12" />
        </svg>
      </a>
    </p>
    <div class="actions">
      <a class="button" href={live ? site.token.tradeUrl! : '#idea'}>
        {live ? 'Buy $FUSD' : 'Explore frozen finance'}{' '}
        <span aria-hidden="true">
          <svg
            class="arrow"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M6 18 18 6M6 6h12v12" />
          </svg>
        </span>
      </a>
      <a class="text-link" href={live ? '#idea' : '#token'}>
        {live ? 'Explore frozen finance' : 'Token details'}{' '}
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <Contract />
  </div>
  <HeroArt />
</section>

<style>
  .hero-reserve-claim {
    max-width: 440px;
    margin-top: 18px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
  }
  .hero-reserve-claim a {
    text-decoration: underline;
    text-decoration-color: #aac8d8;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .hero-reserve-claim a:hover {
    color: var(--blue);
    text-decoration-color: currentColor;
  }
  .hero-reserve-claim .arrow {
    margin-left: 5px;
  }
  @media (max-width: 600px) {
    .hero-reserve-claim {
      font-size: 14px;
      margin-top: 16px;
    }
  }
</style>
