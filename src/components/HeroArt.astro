---
const rings = [
  { name: 'outer', phases: [0, 120, 240] },
  { name: 'inner', phases: [0, 45, 90, 135, 180, 225, 270, 315] },
];
---

<figure
  class="hero-art orbital-scene"
  aria-label="Frozen USD tokens circulate while remaining frozen."
>
  <div class="orbital-system" aria-hidden="true">
    <svg
      class="orbital-guides"
      viewBox="0 0 1000 1000"
      width="1000"
      height="1000"
    >
      <circle cx="500" cy="500" r="420" />
      <circle cx="500" cy="500" r="250" />
      {[0, 120, 240].map((angle) => (
        <circle
          cx="500"
          cy="290"
          r="210"
          transform={`rotate(${angle} 500 500)`}
        />
      ))}
    </svg>
    <div class="central-cube">
      <img
        src="/media/frozen-dollar.webp"
        width="960"
        height="960"
        alt=""
        fetchpriority="high"
      />
    </div>
    {rings.map(({ name, phases }) => (
      <div class={`orbital-ring orbital-ring-${name}`}>
        {phases.map((phase) => (
          <div
            class="orbit-carrier moving-object"
            style={`--phase: ${phase}deg; --counter-phase: ${-phase}deg`}
          >
            <div class="orbit-offset">
              <div class="orbit-counter">
                <img
                  src="/media/frozen-dollar-small.webp"
                  width="480"
                  height="480"
                  alt=""
                />
              </div>
            </div>
          </div>
        ))}
      </div>
    ))}
  </div>
  <figcaption>
    <div>
      <span class="status-dot"></span> In circulation
      <br />
      <span class="caption-indent">Temperature: unchanged</span>
    </div>
    <button class="motion-toggle" aria-pressed="false" hidden>
      Pause movement
    </button>
  </figcaption>
</figure>
<style>
  .orbital-scene {
    display: block;
    align-self: center;
    min-width: 0;
    width: 100%;
    max-width: 540px;
    justify-self: center;
    background: radial-gradient(ellipse at 50% 46%, #edf8fd, #fff 72%);
  }
  .orbital-system {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    isolation: isolate;
    overflow: clip;
  }
  .orbital-guides {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: #9dbfce;
    stroke-width: 1.2;
    stroke-dasharray: 3 7;
  }
  .central-cube {
    position: absolute;
    width: 25.5%;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .orbital-scene img {
    display: block;
    width: 100%;
    height: auto;
  }
  .orbital-ring {
    position: absolute;
    inset: 0;
  }
  .orbital-scene .orbit-carrier {
    position: absolute;
    inset: 0;
    width: auto;
    margin: 0;
    filter: none;
    transform: rotate(var(--phase));
    animation: none;
  }
  .orbit-offset {
    position: absolute;
    left: 50%;
    top: 8%;
    width: 14.5%;
    transform: translate(-50%, -50%);
  }
  .orbital-ring-inner .orbit-offset {
    top: 25%;
    width: 9.3%;
  }
  .orbit-counter {
    transform: rotate(var(--counter-phase));
  }
  .orbital-scene:global(.motion-ready) .orbit-carrier {
    animation: orbit-clockwise 100s linear infinite;
  }
  .orbital-scene:global(.motion-ready) .orbit-counter {
    animation: orbit-counterclockwise 100s linear infinite;
  }
  .orbital-scene:global(.motion-ready) .orbital-ring-inner .orbit-carrier {
    animation-name: orbit-counterclockwise;
  }
  .orbital-scene:global(.motion-ready) .orbital-ring-inner .orbit-counter {
    animation-name: orbit-clockwise;
  }
  .orbital-scene:global(.motion-ready:not(.is-moving))
    :is(.orbit-carrier, .orbit-counter) {
    animation-play-state: paused;
  }
  @keyframes orbit-clockwise {
    from {
      transform: rotate(var(--phase, var(--counter-phase)));
    }
    to {
      transform: rotate(calc(var(--phase, var(--counter-phase)) + 360deg));
    }
  }
  @keyframes orbit-counterclockwise {
    from {
      transform: rotate(var(--phase, var(--counter-phase)));
    }
    to {
      transform: rotate(calc(var(--phase, var(--counter-phase)) - 360deg));
    }
  }
  /* Each counter uses its own complete negative phase, including at rest. */
  .orbit-counter {
    --phase: var(--counter-phase);
  }
  .orbital-scene figcaption {
    margin: 18px 12px 0;
    padding: 16px 0;
    border-top: 1px solid #dcebf2;
  }
  @media (prefers-reduced-motion: reduce) {
    .orbital-scene:global(.motion-ready) :is(.orbit-carrier, .orbit-counter) {
      animation: none !important;
    }
  }
</style>
