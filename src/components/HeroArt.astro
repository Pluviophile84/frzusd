---
// Transfer choreography informed by the owner's frozenusd repository,
// HeroArt.astro at f9845579b81a76303152642afab26f2f7d182c52.
---

<figure class="hero-art transfer-scene" aria-labelledby="ice-caption">
  <div class="scene-heading">
    <span>FROZEN IN TRANSIT</span>
    <span>CONCEPT ILLUSTRATION</span>
  </div>
  <div class="transfer-stage">
    <svg
      class="transfer-canvas"
      viewBox="0 90 620 470"
      width="620"
      height="470"
      role="img"
      aria-label="The cyan Frozen USD coin enclosed at the centre of transparent ice, travelling intact between Wallet A and Wallet B."
    >
      <defs>
        <linearGradient id="platform-top" x2="0" y2="1">
          <stop stop-color="#fff" />
          <stop offset="1" stop-color="#e1f3fb" />
        </linearGradient>
        <linearGradient id="platform-side">
          <stop stop-color="#d0eaf5" />
          <stop offset="1" stop-color="#aad5e8" />
        </linearGradient>
        <radialGradient id="contact-shadow">
          <stop stop-color="#256780" stop-opacity=".24" />
          <stop offset="1" stop-color="#256780" stop-opacity="0" />
        </radialGradient>
        <marker
          id="transfer-arrow"
          viewBox="0 0 10 10"
          refX="7"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto"
        >
          <path
            d="m2 1 5 4-5 4"
            fill="none"
            stroke="#649caf"
            stroke-width="1.3"
          />
        </marker>
      </defs>
      {[155, 455].map((x, i) => (
        <g class="destination">
          <path
            d={`M${x - 105} 444v11a105 23 0 0 0 210 0v-11`}
            fill="url(#platform-side)"
            stroke="#a8cddd"
          />
          <ellipse
            cx={x}
            cy="444"
            rx="105"
            ry="23"
            fill="url(#platform-top)"
            stroke="#b2d6e5"
          />
          <ellipse
            cx={x}
            cy="444"
            rx="76"
            ry="15"
            fill="none"
            stroke="#82b7cc"
            stroke-dasharray="3 6"
          />
          <text x={x} y="499" text-anchor="middle">
            Wallet {i === 0 ? 'A' : 'B'}
          </text>
        </g>
      ))}
      <path
        d="M190 402Q310 327 410 404"
        fill="none"
        stroke="#82afc2"
        stroke-dasharray="3 7"
        stroke-width="1.2"
        marker-end="url(#transfer-arrow)"
      />
      <g class="departure-outline" opacity=".5">
        <path
          d="M63 225 88 202H253V410L230 434H63Z M63 225H230V434 M230 225 253 202"
          fill="none"
          stroke="#8ab8cd"
          stroke-dasharray="4 7"
        />
      </g>
      <g class="moving-object">
        <ellipse
          class="transfer-shadow"
          cx="455"
          cy="444"
          rx="106"
          ry="23"
          fill="url(#contact-shadow)"
        />
        <g class="transfer-lift">
          <image
            href="/media/frozen-dollar.webp"
            x="285"
            y="145"
            width="340"
            height="340"
          />
        </g>
      </g>
    </svg>
  </div>
  <figcaption id="ice-caption">
    <div>
      <span class="status-dot"></span> Location: updated
      <br />
      <span class="caption-indent">Temperature: unchanged</span>
    </div>
    <button class="motion-toggle" aria-pressed="false" hidden>
      Pause movement
    </button>
  </figcaption>
</figure>
<style>
  .transfer-scene {
    display: block;
    align-self: center;
    min-width: 0;
    background: none;
    border: 1px solid #d7e8f0;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 16px 50px #163c4e05;
  }
  .scene-heading {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 24px 24px 0;
    font: 9px/1.5 monospace;
    letter-spacing: 0.08em;
    color: var(--muted);
    background: #f5fbfe;
  }
  .transfer-stage {
    background: linear-gradient(180deg, #f5fbfe, #e4f3fa);
    position: relative;
    isolation: isolate;
  }
  .transfer-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(#fff9 1px, transparent 1px),
      linear-gradient(90deg, #fff9 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: linear-gradient(#000, transparent);
    z-index: -1;
  }
  .transfer-canvas {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .destination text {
    font:
      12px Manrope,
      sans-serif;
    font-weight: 600;
    fill: var(--ink);
    letter-spacing: 0.03em;
  }
  .transfer-scene .moving-object {
    animation: none;
    transform: none;
    filter: none;
    width: auto;
    margin: 0;
  }
  .transfer-scene figcaption {
    padding: 16px 22px;
    margin: 0;
    border-top: 1px solid #d3e6ef;
    background: #f8fcfe;
  }
  .transfer-shadow {
    transform-origin: 455px 444px;
  }
  .transfer-scene:global(.motion-ready) .moving-object {
    animation: transfer-x 14s infinite both;
  }
  .transfer-scene:global(.motion-ready) .transfer-lift {
    animation: transfer-y 14s infinite both;
  }
  .transfer-scene:global(.motion-ready) .transfer-shadow {
    animation: transfer-shadow 14s infinite both;
  }
  .transfer-scene:global(.motion-ready:not(.is-moving))
    :is(.moving-object, .transfer-lift, .transfer-shadow) {
    animation-play-state: paused;
  }
  @keyframes transfer-x {
    0%,
    28% {
      transform: translateX(0);
      animation-timing-function: cubic-bezier(0.55, 0, 0.35, 1);
    }
    46%,
    78% {
      transform: translateX(-300px);
      animation-timing-function: cubic-bezier(0.55, 0, 0.35, 1);
    }
    96%,
    100% {
      transform: translateX(0);
    }
  }
  @keyframes transfer-y {
    0%,
    28% {
      transform: translateY(0);
      animation-timing-function: cubic-bezier(0.3, 0, 0.4, 1);
    }
    37% {
      transform: translateY(-42px);
      animation-timing-function: cubic-bezier(0.6, 0, 0.7, 1);
    }
    46%,
    78% {
      transform: translateY(0);
      animation-timing-function: cubic-bezier(0.3, 0, 0.4, 1);
    }
    87% {
      transform: translateY(-42px);
      animation-timing-function: cubic-bezier(0.6, 0, 0.7, 1);
    }
    96%,
    100% {
      transform: translateY(0);
    }
  }
  @keyframes transfer-shadow {
    0%,
    28%,
    46%,
    78%,
    96%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    37%,
    87% {
      transform: scale(0.72);
      opacity: 0.45;
    }
  }
  @media (max-width: 600px) {
    .scene-heading {
      padding: 18px 16px 0;
      font-size: 8px;
    }
    .transfer-scene {
      margin: 0;
      border-radius: 12px;
    }
    .transfer-scene figcaption {
      padding: 12px 14px;
    }
    .destination text {
      font-size: 15px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .transfer-scene:global(.motion-ready)
      :is(.moving-object, .transfer-lift, .transfer-shadow) {
      animation: none !important;
      transform: none !important;
    }
  }
</style>
