---
// Original Frozen USD orbit composition, informed by the owner's description
// of circulating tokens. Tether's live site was blocked by the network policy.
const phases = [-1, -6, -11, -16];
---

<figure class="hero-art orbit-scene" aria-labelledby="ice-caption">
  <div class="scene-heading">
    <span>FROZEN. STILL MOVING.</span>
    <span>$FUSD</span>
  </div>
  <div class="orbit-stage">
    <svg
      class="orbit-canvas"
      viewBox="0 0 620 540"
      width="620"
      height="540"
      role="img"
      aria-label="Frozen USD tokens circulate continuously around the larger cyan coin suspended inside clear ice."
    >
      <defs>
        <radialGradient id="orbit-halo">
          <stop stop-color="#d9f3ff" stop-opacity=".8" />
          <stop offset="1" stop-color="#edf8fd" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="ice-ground">
          <stop stop-color="#266782" stop-opacity=".13" />
          <stop offset="1" stop-color="#266782" stop-opacity="0" />
        </radialGradient>
        <clipPath id="orbit-rear">
          <rect width="620" height="280" />
        </clipPath>
        <clipPath id="orbit-front">
          <rect y="280" width="620" height="260" />
        </clipPath>
      </defs>
      <ellipse cx="310" cy="270" rx="300" ry="240" fill="url(#orbit-halo)" />
      <ellipse cx="310" cy="441" rx="172" ry="25" fill="url(#ice-ground)" />
      <g clip-path="url(#orbit-rear)" aria-hidden="true">
        <ellipse class="orbit-track" cx="310" cy="280" rx="245" ry="112" />
        {phases.map((phase) => (
          <g
            class="orbit-token moving-object"
            style={`--phase: ${phase}s; --rest: ${-phase * 5}%`}
          >
            <g class="token-depth">
              <circle r="28" cy="3" fill="#75b6cf" opacity=".35" />
              <circle r="28" fill="#e3f7ff" stroke="#b5e7f8" />
              <image
                href="/brand/Frozen-USD-Master.svg"
                x="-24"
                y="-24"
                width="48"
                height="48"
              />
            </g>
          </g>
        ))}
      </g>
      <image
        href="/media/frozen-dollar.webp"
        x="112"
        y="57"
        width="396"
        height="396"
      />
      <g clip-path="url(#orbit-front)" aria-hidden="true">
        <ellipse class="orbit-track" cx="310" cy="280" rx="245" ry="112" />
        {phases.map((phase) => (
          <g
            class="orbit-token moving-object"
            style={`--phase: ${phase}s; --rest: ${-phase * 5}%`}
          >
            <g class="token-depth">
              <circle r="28" cy="3" fill="#75b6cf" opacity=".35" />
              <circle r="28" fill="#e3f7ff" stroke="#b5e7f8" />
              <image
                href="/brand/Frozen-USD-Master.svg"
                x="-24"
                y="-24"
                width="48"
                height="48"
              />
            </g>
          </g>
        ))}
      </g>
      <text x="310" y="493" text-anchor="middle">
        Transfer it. Trade it. No thawing required.
      </text>
    </svg>
  </div>
  <figcaption id="ice-caption">
    <div>
      <span class="status-dot"></span> In circulation
      <br />
      <span class="caption-indent">Temperature: unchanged</span>
    </div>
    <button class="motion-toggle" aria-pressed="false" hidden>
      Pause movement
    </button>
  </figcaption>
</figure>
<style>
  .orbit-scene {
    display: block;
    align-self: center;
    min-width: 0;
    background: radial-gradient(ellipse at 50% 43%, #eef9fe, #fff 72%);
  }
  .scene-heading {
    display: flex;
    justify-content: space-between;
    padding: 20px 24px 0;
    font: 10px/1.5 monospace;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .orbit-canvas {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .orbit-track {
    fill: none;
    stroke: #aacddd;
    stroke-width: 1;
    opacity: 0.7;
  }
  .orbit-canvas text {
    font:
      11px Manrope,
      sans-serif;
    fill: var(--muted);
    letter-spacing: 0.02em;
  }
  .orbit-scene .moving-object {
    width: auto;
    margin: 0;
    filter: none;
    offset-path: path(
      'M 555 280 A 245 112 0 1 1 65 280 A 245 112 0 1 1 555 280'
    );
    offset-rotate: 0deg;
    offset-distance: var(--rest);
    animation: none;
  }
  .token-depth {
    transform: scale(0.9);
  }
  .orbit-scene:global(.motion-ready) .orbit-token {
    animation: circulate 20s linear infinite;
    animation-delay: var(--phase);
  }
  .orbit-scene:global(.motion-ready) .token-depth {
    animation: orbit-depth 20s linear infinite;
    animation-delay: var(--phase);
  }
  .orbit-scene:global(.motion-ready:not(.is-moving))
    :is(.orbit-token, .token-depth) {
    animation-play-state: paused;
  }
  @keyframes circulate {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }
  @keyframes orbit-depth {
    0%,
    50%,
    100% {
      transform: scale(0.9);
      opacity: 0.95;
    }
    25% {
      transform: scale(1.08);
      opacity: 1;
    }
    75% {
      transform: scale(0.72);
      opacity: 0.65;
    }
  }
  .orbit-scene figcaption {
    padding: 16px 24px;
    margin: 0 20px;
    border-top: 1px solid #dcebf2;
  }
  @media (max-width: 600px) {
    .scene-heading {
      padding: 14px 0 0;
      font-size: 9px;
    }
    .orbit-scene figcaption {
      margin: 0;
      padding: 14px 0;
    }
    .orbit-canvas text {
      font-size: 13px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit-scene:global(.motion-ready) :is(.orbit-token, .token-depth) {
      animation: none !important;
    }
  }
</style>
