---
import { site, indexable } from '../config/site';
import '../styles/global.css';
const { title = 'FROZEN USD — Frozen. Still moving.', notFound = false } =
  Astro.props;
const description =
  'The dollar that trades frozen. Transfer it. Trade it. No thawing required. $FRZUSD is a memecoin parody of stablecoins and the freeze button.';
const canonical = site.canonicalOrigin
  ? new URL(Astro.url.pathname, site.canonicalOrigin).href
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable && !notFound ? 'index, follow' : 'noindex, nofollow'}
    />
    {canonical && !notFound && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="preload"
      href="/fonts/manrope-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#F2F8FC" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={
        site.canonicalOrigin
          ? new URL('/media/social.png', site.canonicalOrigin).href
          : '/media/social.png'
      }
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="FROZEN USD. Frozen. Still moving. The dollar that trades frozen."
    />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <slot />
    <script>
      import '../scripts/interactions';
    </script>
  </body>
</html>
