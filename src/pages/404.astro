---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Page not found — FROZEN USD" notFound>
  <Header />
  <main id="main" class="not-found wrap">
    <p class="eyebrow">404 / LOCATION UNKNOWN</p>
    <h1>
      This dollar moved.
      <br />
      The page didn't.
    </h1>
    <p>We couldn't find that page. The homepage is still available.</p>
    <a class="button" href="/">
      Back to Frozen USD <span aria-hidden="true">→</span>
    </a>
  </main>
  <Footer />
</BaseLayout>
