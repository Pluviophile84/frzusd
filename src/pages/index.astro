---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Reserves from '../components/Reserves.astro';
import Footer from '../components/Footer.astro';
import Contract from '../components/Contract.astro';
import { stages, benefits, faqs, posters } from '../content/home';
import { site } from '../config/site';
const live = site.token.status === 'live';
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <Reserves />
    <div class="slogan-band">
      <div class="wrap">
        <span>FROZEN. STILL MOVING.</span>
        <span aria-hidden="true">↓</span>
        <span>A new standard in frozen finance.</span>
      </div>
    </div>
    <section id="idea" class="section wrap idea">
      <div>
        <p class="eyebrow">A NEW STANDARD IN FROZEN FINANCE</p>
        <h2>We gave frozen dollars somewhere to go.</h2>
        <p class="idea-signature">
          Hot wallet.
          <br />
          <span>Cold dollars.</span>
        </p>
      </div>
      <div class="idea-body">
        <p>The industry proved digital dollars can freeze.</p>
        <p>We wondered why that had to be the end of the transaction.</p>
        <div class="solid-statement">
          <p>
            Stablecoins made the dollar stable.
            <br />
            We made it solid.
            <br />
            <strong>Then we let it circulate.</strong>
          </p>
          <img
            src="/media/frozen-dollar-small.webp"
            width="160"
            height="160"
            alt=""
            loading="lazy"
          />
        </div>
      </div>
    </section>
    <section id="how-it-works" class="product section">
      <div class="wrap">
        <div class="section-heading">
          <span class="eyebrow">THE PRODUCT / 01</span>
          <h2>
            Change hands.
            <br />
            Keep your temperature.
          </h2>
        </div>
        <div class="stages">
          {stages.map(([title, text], i) => (
            <article class="stage">
              <div class="stage-art">
                <span class="stage-wallet" aria-hidden="true">
                  {i === 1 ? 'B' : 'A'}
                </span>
                <img
                  src="/media/frozen-dollar-small.webp"
                  width="240"
                  height="240"
                  loading="lazy"
                  alt="Frozen USD coin encased in the same ice block"
                />
                {i < 2 && (
                  <span class="stage-arrow" aria-hidden="true">
                    →
                  </span>
                )}
              </div>
              <div class="stage-title">
                <span>0{i + 1}</span>
                <h3>{title}</h3>
              </div>
              <p>{text}</p>
            </article>
          ))}
        </div>
        <div class="proof">
          <strong>No thawing required.</strong>
          <div>
            <span>Departure: frozen.</span>
            <span>Arrival: frozen.</span>
            <span>Ownership: changed.</span>
            <small>Fictional Proof of Cold.</small>
          </div>
        </div>
      </div>
    </section>
    <section class="section wrap benefits">
      <div class="section-heading">
        <span class="eyebrow">BUILT AROUND A COLD IDEA</span>
        <h2>
          Keep the cold.
          <br />
          Keep the movement.
        </h2>
      </div>
      <div class="benefit-grid">
        {benefits.map(([title, text], i) => (
          <article>
            <div class={`benefit-drawing drawing-${i}`} aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="satire">
      <div class="wrap section">
        <div class="satire-head">
          <span class="eyebrow">A NOTE ON FINANCIAL FREEDOM</span>
          <span aria-hidden="true">
            <svg
              class="arrow"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M6 18 18 6M6 6h12v12" />
            </svg>
          </span>
        </div>
        <h2>
          Decentralized
          <br />
          <span>until further notice.</span>
        </h2>
        <div class="satire-body">
          <p>
            The network is open.
            <br />
            The wallet is yours.
            <br />
            The token may still have an issuer with instructions.
          </p>
          <div>
            <p>
              Frozen USD takes that contradiction and gives it a product launch.
            </p>
            <strong>Your keys. Our freezer.</strong>
          </div>
        </div>
        {site.features.datedNews && (
          <details class="editorial-note">
            <summary>
              <span class="eyebrow">OCTOBER 2026</span>
              <span>The industry found the freezer.</span>
              <span class="note-plus" aria-hidden="true">
                +
              </span>
            </summary>
            <div>
              <p>
                Binance's October 30, 2026 update reported approximately $3
                billion in affected assets frozen after the hack.
              </p>
              <p>
                They demonstrated the cold part.
                <br />
                Our fictional research department would like to discuss the
                movement part.
              </p>
              <a href="https://www.binance.com/en/support/announcement/detail/d3306d9dca5243548c813b605e1d1751">
                Read Binance's dated update{' '}
                <svg
                  class="arrow"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <path d="M6 18 18 6M6 6h12v12" />
                </svg>
              </a>
            </div>
          </details>
        )}
      </div>
    </section>
    <section id="token" class="section wrap token">
      <div>
        <p class="eyebrow">Frozen USD / $FUSD</p>
        <h2>The cold facts.</h2>
        <p>
          Frozen USD is a memecoin parody. No dollar peg. No dollar redemption.
          The frozen-dollar technology is the joke.
        </p>
        <span class="status-pill">
          <span class="status-dot"></span>
          {live ? 'Live' : 'Pre-launch'}
        </span>
      </div>
      <div>
        <dl class="facts">
          <div>
            <dt>Name</dt>
            <dd>Frozen USD</dd>
          </div>
          <div>
            <dt>Ticker</dt>
            <dd>$FUSD</dd>
          </div>
          <div>
            <dt>Network</dt>
            <dd>{site.token.networkLabel ?? 'To be announced'}</dd>
          </div>
          <div>
            <dt>Contract</dt>
            <dd class="address">
              {live ? site.token.contractAddress : 'Not available yet'}
            </dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>{live ? 'Live' : 'Pre-launch'}</dd>
          </div>
        </dl>
        {live ? (
          <>
            <Contract />
            <a class="button" href={site.token.tradeUrl!}>
              Buy $FUSD{' '}
              <svg
                class="arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M6 18 18 6M6 6h12v12" />
              </svg>
            </a>
          </>
        ) : (
          <p class="small muted">
            Official token links will appear here when available.
          </p>
        )}
      </div>
    </section>
    <section id="memes" class="community section">
      <div class="wrap">
        <p class="eyebrow">COLD HARD MEMES</p>
        <div class="community-heading">
          <h2>
            Some people hold dollars.
            <br />
            <span>Some people hold opinions about dollars.</span>
          </h2>
          <div>
            <p>$FUSD is for the second group.</p>
            <p>Make the image. Pass the line around. Keep it cold.</p>
          </div>
        </div>
        <div class="posters">
          {posters.map(([slug, title], i) => (
            <figure>
              <img
                src={`/media/${slug}.svg`}
                width="720"
                height="900"
                alt={title}
                loading="lazy"
              />
              <figcaption>
                <span>
                  0{i + 1} /{' '}
                  {['THE PREMISE', 'THE CONTROL', 'THE BREAKTHROUGH'][i]}
                </span>
                <a
                  href={`/media/${slug}.svg`}
                  download
                  aria-label={`Download ${title}`}
                >
                  Download <span aria-hidden="true">↓</span>
                </a>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="community-bottom">
          <p>Hold the meme. Question the money.</p>
          <div>
            {site.social.xUrl && (
              <a class="text-link" href={site.social.xUrl}>
                Follow on X{' '}
                <svg
                  class="arrow"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <path d="M6 18 18 6M6 6h12v12" />
                </svg>
              </a>
            )}
            {site.social.communityUrl && (
              <a class="text-link" href={site.social.communityUrl}>
                Community{' '}
                <svg
                  class="arrow"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <path d="M6 18 18 6M6 6h12v12" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
    <section id="faq" class="section wrap faq">
      <div>
        <p class="eyebrow">A FEW COLD ANSWERS</p>
        <h2>
          Good questions.
          <br />
          Solid answers.
        </h2>
      </div>
      <div>
        {faqs.map(([question, answer]) => (
          <details>
            <summary>
              {question}
              <span aria-hidden="true">+</span>
            </summary>
            {answer.split('\n\n').map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </details>
        ))}
      </div>
    </section>
    <section class="final-cta">
      <div class="wrap">
        <img
          src="/brand/Frozen-USD-Symbol-Ink.svg"
          width="80"
          height="80"
          alt=""
        />
        <h2>
          Put a cold idea
          <br />
          into circulation.
        </h2>
        <p>Frozen. Still moving.</p>
        <div class="actions">
          <a class="button" href={live ? site.token.tradeUrl! : '#token'}>
            {live ? 'Buy $FUSD' : 'The cold facts'}{' '}
            <span aria-hidden="true">
              <svg
                class="arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M6 18 18 6M6 6h12v12" />
              </svg>
            </span>
          </a>
          {site.social.xUrl && (
            <a class="text-link" href={site.social.xUrl}>
              Follow on X{' '}
              <svg
                class="arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M6 18 18 6M6 6h12v12" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
